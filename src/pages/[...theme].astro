---
import content from "../content.json";
export function getStaticPaths() {
  return [undefined, 'station', 'terminal', 'orbit'].map(theme => ({ params: { theme } }));
}
const theme = Astro.params.theme ?? 'orbit';
const names = { station: 'Estação orbital', terminal: 'Terminal pessoal', orbit: 'Órbita pixel' };
const { projects, community } = content;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="souomeneses — Memory Module, Glifo.ai, MCPocket e a comunidade Vibe Mode." />
    <title>{content.name} · {names[theme as keyof typeof names]}</title>
    <style is:global>
      @font-face { font-family: Pixel; src: url('/fonts/silkscreen.ttf') format('truetype'); font-display: swap; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100svh; font-family: 'Courier New', monospace; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; }
      .bio { width: min(100% - 44px, 420px); margin: 0 auto; padding: 30px 0 24px; position: relative; }
      .top { display: flex; justify-content: space-between; align-items: center; font-size: 9px; letter-spacing: .12em; }
      .signal { display: inline-block; width: 6px; height: 6px; background: var(--accent); margin-right: 7px; }
      header { text-align: center; padding: 43px 0 30px; }
      .avatar { width: 68px; height: 68px; display: grid; place-items: center; margin: auto auto 20px; font: 22px Pixel, monospace; position: relative; }
      h1 { font: 22px/1.3 Pixel, monospace; letter-spacing: -1px; margin: 0 0 9px; }
      .tagline { font-size: 11px; opacity: .65; margin: 0; }
      .socials { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
      .socials a { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 4px; }
      .socials img { width: 24px; height: 24px; object-fit: contain; }
      .socials a:hover { background: #ffffff14; }
      .station .socials img { filter: brightness(0); }
      .station .socials a:hover { background: #0000000c; }
      .terminal .socials { justify-content: flex-start; }
      @media(max-width: 380px) { .socials { gap: 2px; } }
      .section-label { display: flex; justify-content: space-between; font-size: 9px; letter-spacing: .15em; margin: 0 0 13px; opacity: .6; }
      .links { display: grid; gap: 12px; }
      .project { min-height: 76px; display: flex; gap: 15px; align-items: center; padding: 14px 17px; position: relative; transition: transform .15s, background .15s; }
      .project:hover { transform: translateY(-2px); }
      .icon { width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 auto; font-weight: bold; font-size: 17px; }
      .icon img { width: 30px; height: 30px; object-fit: contain; }
      .project strong { display: block; font: 600 15px/1.4 'Helvetica Neue', Helvetica, sans-serif; }
      .project small { display: block; font-size: 8px; letter-spacing: .1em; margin-top: 4px; opacity: .55; }
      .arrow { margin-left: auto; font-size: 20px; }
      .community { display: flex; gap: 14px; align-items: center; padding: 18px; margin-top: 24px; min-height: 74px; }
      .community strong { font-size: 14px; display: block; }
      .community small { font-size: 10px; display: block; margin-top: 5px; }
      .community img { width: 25px; height: 25px; flex-shrink: 0; }
      footer { display: flex; justify-content: space-between; margin-top: 30px; font-size: 8px; opacity: .45; letter-spacing: .07em; }
      .planet, .terminal-bar { display: none; }
      .station { --accent: #e3b80d; color: #202223; background: #e9eae7; background-image: radial-gradient(#c7c9c2 0.6px, transparent .6px); background-size: 10px 10px; }
      .station .bio { background: #f7f7f2; border: 1px solid #cbcdc5; margin-top: 24px; margin-bottom: 24px; padding: 22px; width: min(100% - 28px, 432px); box-shadow: 5px 5px 0 #d2d4cd; }
      .station .top { border-bottom: 1px solid #d8d9d2; padding-bottom: 17px; }
      .station .avatar { background: #242729; color: #f7cd38; border-radius: 14px 14px 3px 14px; box-shadow: 5px 5px 0 #f7cd38; }
      .station .avatar::after { content: '+'; position: absolute; right: -16px; top: -15px; color: #363a37; font: 16px monospace; }
      .station .project { background: white; border: 1px solid #d4d5cc; border-left: 3px solid #242729; box-shadow: 0 3px 0 #e4e5de; }
      .station .icon { background: #f0f1eb; border: 1px solid #e0e2d9; }
      .station .community { background: #f7cd38; border: 1px solid #d7ac1a; color: #23251e; }
      .terminal { --accent: #ffbf47; background: #14110b; color: #eee5d3; background-image: linear-gradient(#ffffff02 1px, transparent 1px); background-size: 100% 4px; }
      .terminal .bio { padding-top: 26px; }
      .terminal .top { color: #ac9260; }
      .terminal header { text-align: left; padding-top: 45px; padding-bottom: 31px; }
      .terminal .avatar { margin-left: 0; color: #ffbf47; width: 58px; height: 53px; border: 2px solid #ffbf47; box-shadow: 4px 4px 0 #694d1e; }
      .terminal h1 { color: #ffbf47; font-size: 24px; max-width: 240px; }
      .terminal .tagline::before { content: '$ '; color: #ffbf47; }
      .terminal .terminal-bar { display: flex; justify-content: space-between; padding: 10px 12px; background: #302617; color: #baa278; font-size: 9px; margin-bottom: 0; border: 1px solid #554126; }
      .terminal .section-label { display: none; }
      .terminal .links { gap: 0; padding: 5px 14px; border: 1px solid #554126; border-top: 0; background: #1c160e; }
      .terminal .project { padding: 16px 0; border-bottom: 1px dashed #483821; }
      .terminal .project:last-child { border: 0; }
      .terminal .project strong { font-family: 'Courier New', monospace; font-size: 15px; }
      .terminal .project:hover { background: #2b2012; transform: none; }
      .terminal .icon { color: #ffbf47; background: #eef0f7; width: 32px; height: 32px; }
      .terminal .arrow { color: #ffbf47; }
      .terminal .community { background: #ffbf47; color: #211507; box-shadow: 4px 4px 0 #75521c; clip-path: polygon(0 0, calc(100% - 7px) 0, calc(100% - 7px) 7px, 100% 7px, 100% 100%, 7px 100%, 7px calc(100% - 7px), 0 calc(100% - 7px)); }
      .orbit { --accent: #f0ce50; color: #e5e8f2; background: #0d0d0d; background-image: radial-gradient(circle at 17% 14%, #8792b4 1px, transparent 1.5px), radial-gradient(circle at 83% 65%, #5d6681 1px, transparent 1.5px), radial-gradient(circle at 65% 30%, #474c61 .7px, transparent 1.2px); background-size: 153px 187px, 221px 263px, 79px 97px; }
      .orbit .top { color: #949cb4; }
      .orbit header { padding-top: 24px; position: relative; }
      .orbit .avatar { display: none; }
      .orbit .planet { display: block; height: 200px; width: 100%; margin: -7px auto 15px; position: relative; }
      .orbit .planet img { position: absolute; width: 260px; height: 260px; object-fit: contain; top: 50%; left: 50%; transform: translate(-50%, -50%); image-rendering: pixelated; }
      .orbit .planet canvas { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
      .orbit .planet[data-ready] img { visibility: hidden; }
      .orbit h1 { font-size: 22px; }
      .orbit .project { min-height: 68px; padding-block: 10px; border: 1px solid #d6dae5; background: #eef0f7; color: #161d30; border-radius: 3px; box-shadow: 4px 4px 0 #29324a; }
      .orbit .icon { background: #dce1ed; color: #283957; }
      .orbit .community { background: #f0ce50; color: #1e2330; border-radius: 3px; box-shadow: 4px 4px 0 #665c35; }
      @media (prefers-reduced-motion: reduce) { .project { transition: none; } }
      @media (max-width: 350px) { .bio { width: calc(100% - 28px); } .station .bio { padding: 17px; } .project { gap: 10px; padding-inline: 12px; } h1 { font-size: 19px !important; } .community { padding: 14px 12px; gap: 9px; } }
    </style>
  </head>
  <body class={theme}>
    <main class="bio">
      <div class="top"><span><span class="signal"></span>{theme === 'terminal' ? '~/lucas' : theme === 'orbit' ? content.topLabel : 'LM — PERSONAL STATION'}</span>{theme !== 'orbit' && <span>{theme === 'terminal' ? 'links.md' : 'LINKS / 01'}</span>}</div>
      <header>
        <div class="avatar" aria-hidden="true">LM</div>{theme === 'orbit' && <div class="planet" aria-hidden="true"><img src="/uranus.png" alt="" width="864" height="864" /><canvas id="orbit-planet"></canvas></div>}
        <h1>{content.name}</h1><p class="tagline">{content.tagline}</p>
        <nav class="socials" aria-label="Redes sociais">
          {content.socials.map(social => <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={`${social.name} (abre em nova aba)`} title={social.name}><img src={social.logo} alt="" width="24" height="24" /></a>)}
        </nav>
      </header>
      <div class="section-label"><span>{theme === 'orbit' ? 'IN MY ORBIT' : 'PROJETOS'}</span><span>01 — {String(projects.length).padStart(2, "0")}</span></div>
      <div class="terminal-bar" aria-hidden="true"><span>+ projects</span><span>{projects.length} entries</span></div>
      <nav class="links" aria-label="Meus projetos">
        {projects.map(project => <a class="project" href={project.url} target="_blank" rel="noopener noreferrer"><span class="icon" aria-hidden="true"><img src={project.logo} alt="" width="30" height="30" /></span><span><strong>{project.name}</strong><small>{project.label}</small></span><span class="arrow" aria-hidden="true">↗</span><span class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)"> (abre em nova aba)</span></a>)}
      </nav>
      <a class="community" href={community.url} target="_blank" rel="noopener noreferrer" aria-label={`${community.name}, ${community.label} (abre em nova aba)`}>
        <img src={community.logo} alt="" width="25" height="25" />
        <span><strong>{community.name}</strong><small>{community.label}</small></span><span class="arrow" aria-hidden="true">↗</span>
      </a>
      <footer><span>{theme === 'terminal' ? '// always building' : 'MADE OF CURIOSITY'}</span><span aria-hidden="true">{theme === 'orbit' ? '✦ · ✧' : '[ LM ]'}</span></footer>
    </main>
    {theme === 'orbit' && <script is:inline type="module" src="/orbit.js"></script>}
  </body>
</html>
